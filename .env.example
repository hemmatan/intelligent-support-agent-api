# Copy to .env and adjust. All application settings use the DORNASHOP_ prefix;
# unprefixed variables such as DEBUG or SECRET_KEY are deliberately ignored.

# Runtime environment: development | production
DORNASHOP_ENVIRONMENT=development
DORNASHOP_DEBUG=true

# JWT signing. Production requires at least 32 characters and rejects this
# default value; generate one with: python -c "import secrets; print(secrets.token_urlsafe(32))"
DORNASHOP_SECRET_KEY=development-only-change-me-32-bytes
DORNASHOP_ALGORITHM=HS256
DORNASHOP_JWT_ISSUER=dornashop-api
DORNASHOP_JWT_AUDIENCE=dornashop-users
DORNASHOP_ACCESS_TOKEN_EXPIRE_MINUTES=15
DORNASHOP_REFRESH_TOKEN_EXPIRE_DAYS=7

# JSON array or comma-separated list. Wildcards are rejected in production.
DORNASHOP_CORS_ORIGINS=["http://localhost:3000","http://localhost:8000"]

# Database: sqlite | postgresql
DORNASHOP_DB_ENGINE=sqlite
DORNASHOP_DB_NAME=db.sqlite3

# Required for postgresql only
# DORNASHOP_DB_USER=postgres
# DORNASHOP_DB_PASSWORD=password
# DORNASHOP_DB_HOST=localhost
# DORNASHOP_DB_PORT=5432
