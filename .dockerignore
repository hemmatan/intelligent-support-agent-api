# Secrets and local configuration never belong in a build context.
.env
.env.*
**/.env
**/.env.*

# Virtual environments and dependency caches are host-specific.
.venv/
venv/
env/
**/.venv/
**/venv/
**/env/

# Repository history is not application runtime data.
.git
**/.git

# Local databases and their journal files must not be baked into an image.
*.db
**/*.db
*.sqlite
*.sqlite-*
**/*.sqlite
**/*.sqlite-*
*.sqlite3*
**/*.sqlite3*

# Python, test, type-check and lint output is reproducible build noise.
**/__pycache__/
**/*.py[cod]
.pytest_cache/
**/.pytest_cache/
.mypy_cache/
**/.mypy_cache/
.ruff_cache/
**/.ruff_cache/
.coverage
.coverage.*
htmlcov/

# Packaging, editor and operating-system artifacts.
build/
dist/
**/*.egg-info/
.idea/
.vscode/
**/.DS_Store
